# Last.fm API 키 (권장) - https://www.last.fm/api/account/create
LASTFM_API_KEY=your_lastfm_api_key_here

# Spotify (선택) - https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# SoundCloud (선택) - 브라우저 개발자도구 Network에서 client_id
SOUNDCLOUD_CLIENT_ID=

# YouTube Music — 로컬: setup-ytmusic.ps1 → backend/data/ytmusic_headers.json
# 클라우드(Render/Railway): YTMUSIC_HEADERS_JSON 에 JSON 전체를 Secret으로 등록
# YTMUSIC_HEADERS_JSON=


# YouTube Data API v3 (선택) — Google Cloud Console
# YOUTUBE_API_KEY=

# TheAudioDB API 키 (기본값 2 사용 가능)
AUDIODB_API_KEY=2

# MusicBrainz User-Agent
MUSICBRAINZ_USER_AGENT=MusicExplorer/1.0 (selendi1511@gmail.com)

# 상업곡 필터 기준
COMMERCIAL_MIN_LISTENERS=5000
COMMERCIAL_MIN_PLAYCOUNT=10000

# ── AI DJ / 취향 분석 (OpenAI 호환) ─────────────────────────────
# 기본: Google Gemini 무료 tier (카드 불필요, Flash-Lite ~1,000회/일)
# 1) https://aistudio.google.com → Get API key
# 2) 아래 3줄을 .env 에 붙여넣기 (OPENAI_API_KEY 에 Gemini 키 넣음)
OPENAI_API_KEY=AIza...
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
OPENAI_MODEL=gemini-2.0-flash-lite

# Groq 대안 (무료 ~1,000회/일, 빠름)
# OPENAI_API_KEY=gsk_...
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_MODEL=llama-3.3-70b-versatile

# AI DJ 답변 품질 (분석은 OPENAI_MODEL, 답변은 이 모델 — Gemini flash 권장)
# OPENAI_COUNSEL_MODEL=gemini-2.5-flash

# OpenAI 유료 (신규 $5 체험 후 결제)
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# HOST=0.0.0.0
# PORT=8080
# SERVE_STATIC=1
